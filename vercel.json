{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "bunVersion": "1.x",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "regions": ["fra1"],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "{packages/db/migrations/*.sql,packages/linear/schema.graphql,docs/openapi.json}"
    }
  },
  "rewrites": [
    {
      "source": "/graphql",
      "destination": "/api/index"
    },
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
