{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "bunVersion": "1.x",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "{packages/db/migrations/*.sql,packages/linear/schema.graphql,packages/generated/server-markdown.mjs,docs/openapi.json}"
    },
    "api/linear-consumer.mjs": {
      "maxDuration": 60,
      "includeFiles": "{packages/db/migrations/*.sql,packages/linear/schema.graphql,packages/generated/server-markdown.mjs,docs/openapi.json}",
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "tasks-linear-sync",
          "retryAfterSeconds": 30
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/.well-known/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/graphql",
      "destination": "/api/index"
    },
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/account-email",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/internal/linear-sync",
      "schedule": "30 4 * * *"
    }
  ]
}
