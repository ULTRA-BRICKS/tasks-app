{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "@/*": ["./src/*"],
      "@tickets/contracts": ["./packages/contracts/types.ts"]
    },
    "types": ["vite/client", "bun"]
  },
  "include": [
    "src",
    "packages/contracts/types.ts",
    "vite.config.ts",
    ".storybook",
    "vitest.config.ts",
    "playwright.config.ts",
    "tests"
  ],
  "exclude": ["node_modules", "dist"]
}
