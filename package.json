{
  "name": "tasks-app",
  "version": "0.2.0",
  "private": true,
  "description": "Modular, API-first issue tracking for small teams. React + Base UI; PostgreSQL in production.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.hyperide.ai/ultrabricks/tasks-app.git"
  },
  "bin": {
    "tasks-app": "packages/cli/tickets.mjs",
    "tickets": "packages/cli/tickets.mjs"
  },
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.mjs",
    "dev:api": "bun packages/server/dev.mjs",
    "dev:web": "bun --bun vite --host 127.0.0.1",
    "build": "bun run prepare:generated && bun run typecheck && bun --bun vite build && bun scripts/build-shell.mjs",
    "typecheck": "oxlint --type-aware --type-check --deny-warnings",
    "start": "bun packages/server/dev.mjs",
    "db:migrate": "bun scripts/db.mjs migrate",
    "db:bootstrap": "bun scripts/db.mjs bootstrap",
    "demo:seed": "bun scripts/db.mjs demo",
    "tokens:build": "bun scripts/tokens.mjs",
    "tokens:check": "bun scripts/tokens.mjs --check",
    "api:generate": "bun scripts/openapi.mjs",
    "api:check": "bun scripts/openapi.mjs --check",
    "lint:fsd": "bun scripts/check-fsd.mjs",
    "test": "bun test tests/unit",
    "test:coverage": "bun test --coverage tests/unit",
    "storybook": "bun ./node_modules/storybook/dist/bin/dispatcher.js dev -p 6006 --no-open",
    "storybook:build": "bun ./node_modules/storybook/dist/bin/dispatcher.js build -o storybook-static",
    "test:ui": "bun --bun vitest run --project=storybook",
    "test:e2e": "bun scripts/test-e2e.mjs",
    "test:visual": "bun --bun playwright test --project=visual",
    "test:visual:update": "bun --bun playwright test --project=visual --update-snapshots",
    "worker": "bun scripts/worker.mjs",
    "setup": "bun scripts/setup.mjs",
    "check:secrets": "bun scripts/secret-scan.mjs",
    "prepare:generated": "bun scripts/server-markdown.mjs && bun run tokens:build && bun run api:generate && bun run graphql:generate",
    "lint": "oxlint --deny-warnings && bun run lint:fsd",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck:oxc": "oxlint --type-aware --type-check --deny-warnings",
    "graphql:generate": "bun scripts/linear-schema.mjs",
    "graphql:check": "bun scripts/linear-schema.mjs --check",
    "test:postgres": "bun test --timeout 30000 tests/postgres",
    "screenshots": "bun --bun playwright test --project=visual --update-snapshots",
    "check": "bun run prepare:generated && bun run lint && bun run typecheck && bun run test && bun run build",
    "typecheck:tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/s3-request-presigner": "^3.800.0",
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.90.0",
    "@tiptap/core": "3.30.3",
    "@tiptap/extension-image": "3.30.3",
    "@tiptap/extension-placeholder": "3.30.3",
    "@tiptap/extension-table": "3.30.3",
    "@tiptap/extension-task-item": "3.30.3",
    "@tiptap/extension-task-list": "3.30.3",
    "@tiptap/markdown": "3.30.3",
    "@tiptap/pm": "3.30.3",
    "@tiptap/react": "3.30.3",
    "@tiptap/starter-kit": "3.30.3",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^2.0.0",
    "@vercel/queue": "^0.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "16.11.0",
    "lucide-react": "^0.468.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/bun": "1.4.2",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "4.1.10",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "storybook": "10.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
