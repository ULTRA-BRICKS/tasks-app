# Development has an explicit SQLite adapter; production never falls back to it.
NODE_ENV=development
APP_URL=
API_PORT=
SQLITE_PATH=.data/tickets.sqlite
STORAGE_DRIVER=local
UPLOAD_DIR=.data/uploads
# Generate random secrets locally. No demo credentials are used in production.
AUTH_SECRET=
CRON_SECRET=
# Pooled Neon URL for the application, direct URL for migrations/bootstrap.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Bootstrap command only. Do not put these into Vercel's runtime environment.
BOOTSTRAP_EMAIL=
BOOTSTRAP_NAME=
BOOTSTRAP_PASSWORD=
WORKSPACE_NAME=My workspace
WORKSPACE_SLUG=my-workspace
# Optional Cloudflare R2 / S3. Private bucket. Uploads go through the API; no public PUT CORS is needed.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_BYTES=3145728
WORKSPACE_STORAGE_BYTES=524288000
# Integration credentials belong to ONE explicitly configured workspace.
INTEGRATIONS_WORKSPACE_ID=
GITHUB_REPOSITORY=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
SLACK_TEAM_ID=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CHANNEL_ID=

# Defaults live in packages/config/development.mjs; setup persists overrides.
WEB_PORT=

# Optional private Vercel Blob adapter. Never use a VITE_ prefix for this token.
BLOB_READ_WRITE_TOKEN=

# Alternative private storage on Vercel; choose STORAGE_DRIVER=blob.

# Backend-only Resend configuration. Never use a VITE_ prefix for secrets.
# Set MAIL_FROM to a sender on your verified Resend domain.
RESEND_API_KEY=
MAIL_FROM=
# Pending account mail is encrypted with AUTH_SECRET. Keep that secret stable.
